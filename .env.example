# Copia questo file in .env.local e inserisci le tue chiavi.
# Vengono caricate solo dal server locale (npm run dev / Avvia Ascolti.command), mai nella build.

# OpenRouter (https://openrouter.ai/keys): assistente, embedding, mood AI
OPENROUTER_API_KEY=

# LRCLIB app id (facoltativo: di default usa quello registrato del progetto)
LRCLIB_APP_ID=

# Last.fm (facoltativa, https://www.last.fm/api/account/create)
LASTFM_API_KEY=

# Modelli OpenRouter (facoltativi)
LLM_MODEL_BULK=
LLM_MODEL_AGENT=
